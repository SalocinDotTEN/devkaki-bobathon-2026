# ─────────────────────────────────────────────────────
# Newsjack Daily Monitor — environment variables
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real keys.
# ─────────────────────────────────────────────────────

# ── Medialyst (optional but recommended) ─────────────
# Enables live news search beyond RSS feeds.
# Get a free key (300 credits) at: https://medialyst.ai/agents
# Run `newsjack login` to authenticate interactively.
MEDIALYST_API_KEY=
MEDIALYST_API_BASE=https://medialyst.ai/api
MEDIALYST_NEWS_PATH=/v1/news/search

# ── Vercel cron protection (optional) ────────────────
# Set this to a random string and add it to Vercel env vars.
# The cron endpoint will reject requests that don't include it.
CRON_SECRET=

# ── Local store override (optional) ──────────────────
# Where newsjack saves the monitor state locally.
# Defaults to ~/.local/share/newsjack/monitor.db
NEWSJACK_STORE=

# ── X / Twitter API (optional) ───────────────────────
# Enables X trending topics as an extra news source.
# Requires a paid X API plan: https://docs.x.com/x-api
X_BEARER_TOKEN=
TWITTER_BEARER_TOKEN=
