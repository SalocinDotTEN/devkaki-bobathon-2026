---
/**
 * Main dashboard page — server-rendered, no client JS required for initial load.
 * Category filter uses a lightweight client-side script (no framework needed).
 */
import { fetchNews } from "../lib/fetcher";
import type { NewsItem } from "../lib/fetcher";

export const prerender = false;

// Read requested category from query param
const url = new URL(Astro.request.url);
const activeCategory = url.searchParams.get("cat") ?? "All";

let result;
let error: string | null = null;

try {
  result = await fetchNews();
} catch (e: any) {
  error = e.message;
}

const allItems: NewsItem[] = result?.items ?? [];
const fetchedAt: string = result?.fetchedAt ?? new Date().toISOString();
const totalCount: number = result?.totalCount ?? 0;

const CATEGORIES = ["All", "Tech", "AI", "Environment", "Malaysia", "Nature", "Science"];

const CATEGORY_ICONS: Record<string, string> = {
  All: "🌐",
  Tech: "💻",
  AI: "🤖",
  Environment: "🌿",
  Malaysia: "🇲🇾",
  Nature: "🌳",
  Science: "🔬",
};

const filtered =
  activeCategory === "All"
    ? allItems
    : allItems.filter((i) => i.category === activeCategory);

function timeAgo(iso: string): string {
  const diff = Date.now() - new Date(iso).getTime();
  const m = Math.floor(diff / 60_000);
  if (m < 60) return `${m}m ago`;
  const h = Math.floor(m / 60);
  if (h < 24) return `${h}h ago`;
  return `${Math.floor(h / 24)}d ago`;
}

function scoreBadge(score: number): string {
  if (score >= 67) return "high";
  if (score >= 34) return "mid";
  return "low";
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Newsjack Daily — Positive News Monitor</title>
  <meta name="description" content="Daily curated positive news: Tech, AI, Environment, Malaysia, Nature & Science" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #f8faf9;
      --surface: #ffffff;
      --border: #e4e9e6;
      --text: #1a2e22;
      --muted: #5a7368;
      --accent: #1a7f4e;
      --accent-light: #e8f5ef;
      --ai: #5b4fcf;
      --ai-light: #eeeaff;
      --tech: #1a6fa8;
      --tech-light: #e5f0fa;
      --env: #1a7f4e;
      --env-light: #e8f5ef;
      --my: #c8352a;
      --my-light: #fcecea;
      --nat: #3a7d44;
      --nat-light: #eaf4eb;
      --sci: #7b5ea7;
      --sci-light: #f2edf9;
      --radius: 10px;
      --shadow: 0 1px 3px rgba(0,0,0,.08), 0 1px 2px rgba(0,0,0,.05);
    }

    body {
      font-family: -apple-system, "Segoe UI", system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.55;
      min-height: 100vh;
    }

    /* ── Header ── */
    .header {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 0 1.5rem;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .header-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 1rem;
      height: 56px;
    }
    .logo {
      font-weight: 700;
      font-size: 1.1rem;
      color: var(--accent);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: .45rem;
      white-space: nowrap;
    }
    .logo-sub {
      font-size: .75rem;
      font-weight: 400;
      color: var(--muted);
    }
    .header-right {
      margin-left: auto;
      font-size: .78rem;
      color: var(--muted);
      white-space: nowrap;
    }
    .refresh-btn {
      display: inline-flex;
      align-items: center;
      gap: .3rem;
      background: var(--accent-light);
      color: var(--accent);
      border: none;
      border-radius: 6px;
      padding: .3rem .7rem;
      font-size: .78rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: opacity .15s;
    }
    .refresh-btn:hover { opacity: .8; }

    /* ── Hero strip ── */
    .hero {
      background: linear-gradient(135deg, var(--accent) 0%, #2d9a63 100%);
      color: #fff;
      padding: 2rem 1.5rem 1.5rem;
      text-align: center;
    }
    .hero h1 {
      font-size: clamp(1.4rem, 3vw, 2rem);
      font-weight: 700;
      margin-bottom: .4rem;
    }
    .hero p {
      font-size: .92rem;
      opacity: .88;
      max-width: 560px;
      margin: 0 auto;
    }
    .stats-row {
      display: flex;
      justify-content: center;
      gap: 2rem;
      margin-top: 1.2rem;
      flex-wrap: wrap;
    }
    .stat {
      text-align: center;
    }
    .stat-num {
      font-size: 1.6rem;
      font-weight: 700;
      display: block;
    }
    .stat-label {
      font-size: .72rem;
      opacity: .75;
      text-transform: uppercase;
      letter-spacing: .04em;
    }

    /* ── Category tabs ── */
    .tabs-wrap {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 0 1.5rem;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .tabs-wrap::-webkit-scrollbar { display: none; }
    .tabs {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      gap: .25rem;
      padding: .5rem 0;
      white-space: nowrap;
    }
    .tab {
      display: inline-flex;
      align-items: center;
      gap: .3rem;
      padding: .35rem .9rem;
      border-radius: 20px;
      font-size: .83rem;
      font-weight: 500;
      text-decoration: none;
      color: var(--muted);
      background: transparent;
      transition: background .12s, color .12s;
    }
    .tab:hover { background: var(--accent-light); color: var(--accent); }
    .tab.active {
      background: var(--accent);
      color: #fff;
      font-weight: 600;
    }
    .tab-count {
      background: rgba(255,255,255,.25);
      border-radius: 9px;
      padding: 0 .4rem;
      font-size: .7rem;
    }
    .tab:not(.active) .tab-count {
      background: var(--border);
      color: var(--muted);
    }

    /* ── Main layout ── */
    .layout {
      max-width: 1200px;
      margin: 0 auto;
      padding: 1.5rem;
      display: grid;
      grid-template-columns: 1fr 280px;
      gap: 1.5rem;
      align-items: start;
    }
    @media (max-width: 860px) {
      .layout { grid-template-columns: 1fr; }
      .sidebar { display: none; }
    }

    /* ── Cards grid ── */
    .cards-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
    }
    .cards-title {
      font-size: .92rem;
      font-weight: 600;
      color: var(--muted);
    }
    .cards-count {
      font-size: .8rem;
      color: var(--muted);
    }
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1rem;
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.1rem;
      display: flex;
      flex-direction: column;
      gap: .6rem;
      box-shadow: var(--shadow);
      transition: box-shadow .15s, transform .15s;
    }
    .card:hover {
      box-shadow: 0 4px 12px rgba(0,0,0,.1);
      transform: translateY(-1px);
    }

    .card-meta {
      display: flex;
      align-items: center;
      gap: .5rem;
      font-size: .72rem;
    }
    .cat-pill {
      border-radius: 4px;
      padding: .15rem .5rem;
      font-weight: 600;
      font-size: .68rem;
      text-transform: uppercase;
      letter-spacing: .03em;
    }
    .cat-Tech    { background: var(--tech-light); color: var(--tech); }
    .cat-AI      { background: var(--ai-light);   color: var(--ai); }
    .cat-Environment { background: var(--env-light); color: var(--env); }
    .cat-Malaysia    { background: var(--my-light);  color: var(--my); }
    .cat-Nature  { background: var(--nat-light);  color: var(--nat); }
    .cat-Science { background: var(--sci-light);  color: var(--sci); }

    .source { color: var(--muted); flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .time   { color: var(--muted); flex-shrink: 0; }

    .card-title {
      font-size: .95rem;
      font-weight: 600;
      line-height: 1.35;
    }
    .card-title a {
      color: var(--text);
      text-decoration: none;
    }
    .card-title a:hover { color: var(--accent); text-decoration: underline; }

    .card-summary {
      font-size: .82rem;
      color: var(--muted);
      line-height: 1.5;
      flex: 1;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: .4rem;
      border-top: 1px solid var(--border);
    }
    .vibe-bar {
      display: flex;
      align-items: center;
      gap: .4rem;
      font-size: .7rem;
      color: var(--muted);
    }
    .vibe-track {
      width: 48px;
      height: 4px;
      background: var(--border);
      border-radius: 2px;
      overflow: hidden;
    }
    .vibe-fill { height: 100%; border-radius: 2px; }
    .vibe-high .vibe-fill { background: #1a7f4e; }
    .vibe-mid  .vibe-fill { background: #f59e0b; }
    .vibe-low  .vibe-fill { background: var(--border); }

    .read-link {
      font-size: .75rem;
      font-weight: 600;
      color: var(--accent);
      text-decoration: none;
    }
    .read-link:hover { text-decoration: underline; }

    /* ── Sidebar ── */
    .sidebar-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1rem;
      margin-bottom: 1rem;
      box-shadow: var(--shadow);
    }
    .sidebar-title {
      font-size: .82rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .05em;
      color: var(--muted);
      margin-bottom: .8rem;
    }
    .source-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: .3rem;
    }
    .source-item {
      font-size: .8rem;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: .4rem;
    }
    .source-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent);
      flex-shrink: 0;
    }
    .cat-breakdown {
      display: flex;
      flex-direction: column;
      gap: .5rem;
    }
    .cat-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: .8rem;
    }
    .cat-bar-wrap {
      flex: 1;
      height: 5px;
      background: var(--border);
      border-radius: 3px;
      margin: 0 .6rem;
      overflow: hidden;
    }
    .cat-bar { height: 100%; border-radius: 3px; background: var(--accent); }
    .cat-num { color: var(--muted); font-size: .75rem; min-width: 20px; text-align: right; }

    .info-box {
      background: var(--accent-light);
      border: 1px solid #b2dcc9;
      border-radius: 8px;
      padding: .8rem;
      font-size: .78rem;
      color: var(--accent);
      line-height: 1.5;
    }

    /* ── Empty / error ── */
    .empty {
      grid-column: 1/-1;
      text-align: center;
      padding: 4rem 1rem;
      color: var(--muted);
    }
    .empty-icon { font-size: 3rem; margin-bottom: 1rem; }

    /* ── Footer ── */
    .footer {
      text-align: center;
      padding: 2rem 1rem;
      font-size: .75rem;
      color: var(--muted);
      border-top: 1px solid var(--border);
      margin-top: 2rem;
    }
    .footer a { color: var(--accent); }
  </style>
</head>
<body>

<!-- ── Header ── -->
<header class="header">
  <div class="header-inner">
    <a href="/" class="logo">
      🌱 Newsjack Daily
      <span class="logo-sub">Positive News Monitor</span>
    </a>
    <div class="header-right">
      <a href="/" class="refresh-btn">↻ Refresh</a>
    </div>
  </div>
</header>

<!-- ── Hero ── -->
<section class="hero">
  <h1>Today's Positive News</h1>
  <p>Curated daily from Tech, AI, Environment, Malaysia, Nature & Science — good vibes only.</p>
  <div class="stats-row">
    <div class="stat">
      <span class="stat-num">{totalCount}</span>
      <span class="stat-label">Stories</span>
    </div>
    <div class="stat">
      <span class="stat-num">{result?.sources.length ?? 0}</span>
      <span class="stat-label">Sources</span>
    </div>
    <div class="stat">
      <span class="stat-num">{CATEGORIES.length - 1}</span>
      <span class="stat-label">Topics</span>
    </div>
    <div class="stat">
      <span class="stat-num">{timeAgo(fetchedAt)}</span>
      <span class="stat-label">Last fetch</span>
    </div>
  </div>
</section>

<!-- ── Category tabs ── -->
<nav class="tabs-wrap" aria-label="Categories">
  <div class="tabs">
    {CATEGORIES.map((cat) => {
      const count = cat === "All"
        ? allItems.length
        : allItems.filter(i => i.category === cat).length;
      return (
        <a
          href={cat === "All" ? "/" : `/?cat=${cat}`}
          class={`tab${activeCategory === cat ? " active" : ""}`}
        >
          {CATEGORY_ICONS[cat]} {cat}
          <span class="tab-count">{count}</span>
        </a>
      );
    })}
  </div>
</nav>

<!-- ── Main content ── -->
<div class="layout">
  <main>
    <div class="cards-header">
      <span class="cards-title">
        {activeCategory === "All" ? "All Stories" : `${CATEGORY_ICONS[activeCategory] ?? ""} ${activeCategory}`}
      </span>
      <span class="cards-count">{filtered.length} articles</span>
    </div>

    {error && (
      <div class="empty">
        <div class="empty-icon">⚠️</div>
        <p>Could not fetch news: {error}</p>
        <p style="margin-top:.5rem;font-size:.8rem">Check your network or RSS feed availability.</p>
      </div>
    )}

    {!error && filtered.length === 0 && (
      <div class="empty">
        <div class="empty-icon">📭</div>
        <p>No stories found for <strong>{activeCategory}</strong> yet.</p>
        <p style="margin-top:.5rem;font-size:.8rem">Try another category or wait for the next fetch.</p>
      </div>
    )}

    <div class="cards-grid">
      {filtered.map((item) => {
        const badge = scoreBadge(item.positiveScore);
        const pct = item.positiveScore;
        return (
          <article class="card">
            <div class="card-meta">
              <span class={`cat-pill cat-${item.category}`}>{item.category}</span>
              <span class="source" title={item.source}>{item.source}</span>
              <span class="time">{timeAgo(item.publishedAt)}</span>
            </div>

            <div class="card-title">
              <a href={item.url} target="_blank" rel="noopener noreferrer">
                {item.title}
              </a>
            </div>

            {item.summary && (
              <p class="card-summary">{item.summary}</p>
            )}

            <div class="card-footer">
              <div class={`vibe-bar vibe-${badge}`}>
                <div class="vibe-track">
                  <div class="vibe-fill" style={`width:${pct}%`}></div>
                </div>
                <span>Vibe {pct}%</span>
              </div>
              <a href={item.url} target="_blank" rel="noopener noreferrer" class="read-link">
                Read →
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </main>

  <!-- ── Sidebar ── -->
  <aside class="sidebar">
    <!-- Category breakdown -->
    <div class="sidebar-card">
      <div class="sidebar-title">By Category</div>
      <div class="cat-breakdown">
        {CATEGORIES.filter(c => c !== "All").map((cat) => {
          const n = allItems.filter(i => i.category === cat).length;
          const pct = totalCount > 0 ? Math.round((n / totalCount) * 100) : 0;
          return (
            <div class="cat-row">
              <span>{CATEGORY_ICONS[cat]} {cat}</span>
              <div class="cat-bar-wrap">
                <div class="cat-bar" style={`width:${pct}%`}></div>
              </div>
              <span class="cat-num">{n}</span>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Sources -->
    <div class="sidebar-card">
      <div class="sidebar-title">Active Sources</div>
      <ul class="source-list">
        {(result?.sources ?? []).slice(0, 16).map((src) => (
          <li class="source-item">
            <span class="source-dot"></span>
            {src}
          </li>
        ))}
        {(result?.sources.length ?? 0) > 16 && (
          <li class="source-item" style="color:var(--muted);font-style:italic">
            +{(result?.sources.length ?? 0) - 16} more
          </li>
        )}
      </ul>
    </div>

    <!-- Info box -->
    <div class="info-box">
      <strong>How this works</strong><br />
      Feeds are scanned daily. Stories about war, conflict, or politics are automatically excluded. Positive-signal scoring surfaces uplifting news first.
    </div>
  </aside>
</div>

<footer class="footer">
  Powered by <a href="https://newsjack.sh" target="_blank" rel="noopener">newsjack.sh</a> ·
  RSS + Medialyst API · Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
</footer>

</body>
</html>
